<Window x:Class="KrestikNolik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KrestikNolik"
        xmlns:m="clr-namespace:KrestikNolik" ResizeMode="NoResize"
        mc:Ignorable="d"
        Height="620" Width="465" Title="{Binding Source={StaticResource strs}, Path=MyAppTitle}">
    <Window.Resources>
         <Style x:Key="XnO" TargetType="{x:Type Button}">
            
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                <!--<Setter Property="Background" Value="LightBlue"/>-->
                <Setter Property="Height" Value="130"/>
                <Setter Property="Width" Value="130"/>                
                </Trigger>
            </Style.Triggers>
           
        </Style>
   
    </Window.Resources>
    
    <StackPanel  Height="560" Width="450" >
        <TextBlock  Name="tbTablo" Height="20" Width="450" Text="{Binding Source={StaticResource strs}, Path=MyReadyGame}" TextAlignment="Center" Background="LightCyan" ></TextBlock>
      <Grid  Background="DarkGray" Height="450" Width="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Button Name="btn00" Margin="10,10,5,5" Grid.Column="0" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="0"></Button>
        <Button Name="btn10" Margin="5,10,5,5" Grid.Column="1" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="10"></Button>
        <Button Name="btn20" Margin="5,10,10,5" Grid.Column="2" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="20"></Button>
        <Button Name="btn01" Margin="10,5,5,5" Grid.Column="0" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="1"></Button>
        <Button Name="btn11" Margin="5,5,5,5" Grid.Column="1" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="11"></Button>
        <Button Name="btn21" Margin="5,5,10,5" Grid.Column="2" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="21"></Button>
        <Button Name="btn02" Margin="10,5,5,10" Grid.Column="0" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="2"></Button>
        <Button Name="btn12" Margin="5,5,5,10" Grid.Column="1" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="12"></Button>
        <Button Name="btn22" Margin="5,5,10,10" Grid.Column="2" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="22"></Button>    
    </Grid>
        <Button  Name="btnNewGame" Height="20" Width="450" Content="{Binding Source={StaticResource strs}, Path=MyStartAgain}" Background="LightCyan" Click="btnNewGame_Click"></Button>

        <StackPanel x:Name="checkPanel" Orientation="Vertical" Height="100">
            <RadioButton Name="CvsC" Margin="5,5,5,5" Height="16" GroupName="Spēle" Content="{Binding Source={StaticResource strs}, Path=XmanVSOman}" IsChecked="True" />
            <RadioButton Name="CvsD" Margin="5,5,5,5" Height="16" GroupName="Spēle" Content="{Binding Source={StaticResource strs}, Path=XmanVSdators}" />
            <RadioButton Name="DvsC" Margin="5,5,5,5" Height="16" GroupName="Spēle" Content="{Binding Source={StaticResource strs}, Path=XdatorsVSOman}" />
        </StackPanel>
    </StackPanel>
</Window>
