<Window x:Class="KrestikNolik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KrestikNolik"
        xmlns:m="clr-namespace:KrestikNolik"
        mc:Ignorable="d"
        Height="570" Width="465" Title="{Binding Source={StaticResource strs}, Path=MyAppTitle}">
    <Window.Resources>
        <Style x:Key="XnO" TargetType="{x:Type Button}">

            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Height" Value="130"/>
                    <Setter Property="Width" Value="130"/>
                    <!--<Setter Property="Margin" Value="5,5,5,5"/>
                    <EventSetter Event="Button.Click" Handler="Button_Click" />-->
                </Trigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>
    
    <StackPanel  Height="560" Width="450" >
        <TextBlock  Name="tbTablo" Height="20" Width="450" Text="Gatavs spēlei" TextAlignment="Center" Background="LightCyan" ></TextBlock>
        <!--<StackPanel  Height="450" Width="450" >-->
         <!--<ItemsControl Name="PoleIgri" ItemsSource="{Binding Buttons}">
          <ItemsControl.ItemsPanel>
           <ItemsPanelTemplate>-->
           <Grid  Name="PoleIgri" Background="DarkGray" Height="450" Width="450">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button Name="btn00" Margin="10,10,5,5" Grid.Column="0" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="0"></Button>
                <Button Name="btn10" Margin="5,10,5,5" Grid.Column="1" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="10"></Button>
                <Button Name="btn20" Margin="5,10,10,5" Grid.Column="2" Grid.Row="0" Click="Button_Click" Style="{StaticResource XnO}" Tag="20"></Button>
                <Button Name="btn01" Margin="10,5,5,5" Grid.Column="0" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="1"></Button>
                <Button Name="btn11" Margin="5,5,5,5" Grid.Column="1" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="11"></Button>
                <Button Name="btn21" Margin="5,5,10,5" Grid.Column="2" Grid.Row="1" Click="Button_Click" Style="{StaticResource XnO}" Tag="21"></Button>
                <Button Name="btn02" Margin="10,5,5,10" Grid.Column="0" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="2"></Button>
                <Button Name="btn12" Margin="5,5,5,10" Grid.Column="1" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="12"></Button>
                <Button Name="btn22" Margin="5,5,10,10" Grid.Column="2" Grid.Row="2" Click="Button_Click" Style="{StaticResource XnO}" Tag="22"></Button>
            </Grid>
                    <!--</ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="{Binding BackFon}" Command="{Binding Command}" Style="{StaticResource XnO}" Width="130" Height="130"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>-->
        <!--</StackPanel>-->
        <Button  Name="btnNewGame" Height="20" Width="450" Content="Sākt spēli no jauna" Background="LightCyan" Click="btnNewGame_Click"></Button>

        <StackPanel x:Name="stackPanel" Orientation="Horizontal" Height="30">
            <RadioButton Name="CvsC" Margin="5,5,5,5" Height="20" GroupName="Spēle" Content="X-Cilvēks vs O-Cilvēks" IsChecked="True" />
            <RadioButton Name="CvsD" Margin="5,5,5,5" Height="20" GroupName="Spēle" Content="X-Cilvēks vs O-Dators" />
            <RadioButton Name="DvsC" Margin="5,5,5,5" Height="20" GroupName="Spēle" Content="X-Dators vs O-Cilvēks" />
        </StackPanel>

        <StackPanel x:Name="stackPole" Orientation="Horizontal" Height="20">
            <ToggleButton x:Name="btn3n3" Content="3 x 3" Width="225" Height="20" IsChecked="true" Checked="btn3n3_Checked"></ToggleButton>
            <ToggleButton x:Name="btn4n4" Content="4 x 4" Width="225" Height="20" Checked="btn4n4_Checked" ></ToggleButton>
        </StackPanel>    
    </StackPanel>
</Window>
